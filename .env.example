# ============================================================
# StockSync Environment Configuration Template
# NOTE: Copy this file to .env and configure your secret values.
# DO NOT commit real secrets or production credentials to Git.
# ============================================================

# Application Environment
NODE_ENV=development
PORT=3000

# Local Database Connection (PostgreSQL Docker Instance)
DB_HOST=localhost
DB_PORT=5432
DB_USER=stocksync_admin
DB_PASSWORD=your_secure_db_password_here
DB_NAME=stocksync_local

# Security & JWT Configuration (Use cryptographically strong keys in production)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=12h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_here
JWT_REFRESH_EXPIRES_IN=7d

# Point of Sale Counter Identification
COUNTER_ID=COUNTER-01
STORE_NAME="StockSync Supermarket"
STORE_ADDRESS="123 Retail Avenue, Tech City"
STORE_GSTIN="27AAAAA0000A1Z5"

# Azure Cloud Sync Configuration
AZURE_SYNC_ENABLED=false
AZURE_SYNC_ENDPOINT=https://your-stocksync-cloud-api.azurewebsites.net/api/v1/sync
AZURE_SYNC_INTERVAL_MS=30000
AZURE_SYNC_API_KEY=your_azure_sync_api_key_here
