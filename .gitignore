# ============================================================
# Root Git Ignore for StockSync Repository
# ============================================================

# Dependencies
node_modules/
**/node_modules/
.npm/

# Build & Compiled Output
dist/
**/dist/
build/
**/build/
out/
**/out/
out-tsc/
**/out-tsc/

# Angular & Frontend Artifacts
.angular/
**/.angular/
coverage/
**/coverage/
.sass-cache/

# Environment and Secret Files
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Database & Local Persistent Data
pgdata/
**/pgdata/
*.sqlite
*.sqlite3
*.db

# Logs and Debugging
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor Configuration
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
**/.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary & Cache Files
tmp/
**/tmp/
temp/
**/temp/
*.tsbuildinfo

# Electron Desktop Artifacts & Installers
release/
**/release/
*.exe
*.blockmap
*.dpapi

# Agents files
.agents/
